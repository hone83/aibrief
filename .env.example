# 이 파일을 복사해서 이름을 .env 로 바꾸고, 값을 채워 넣으세요.
#   cp .env.example .env
#
# .env 는 .gitignore 에 들어 있어서 깃허브에 올라가지 않습니다.
# 여기 적은 비밀번호는 내 컴퓨터에만 남습니다.

# 보내는 Gmail 주소
GMAIL_USER=

# Gmail 앱 비밀번호 16자리 (계정 비밀번호가 아닙니다)
# 만드는 법: Google 계정 → 보안 → 2단계 인증 켜기 → 앱 비밀번호
GMAIL_APP_PASS=

# 받는 주소. 비워두면 GMAIL_USER 로 보냅니다.
MAIL_TO=

# (선택) 텔레그램 알림. 없어도 브리핑은 정상 동작합니다.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# 번역 (config/scoring.yaml 의 translate.engine 에 맞는 것만 채우면 됩니다)
# ---------------------------------------------------------------------------

# engine: gemini 일 때 (기본값) — aistudio.google.com/apikey 에서 발급
# 카드 등록이 필요 없고, 하루 1,500회까지 무료입니다.
GEMINI_API_KEY=

# engine: claude 일 때 — console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=

# engine: deepl 일 때 — deepl.com/pro-api 에서 무료 가입 후 발급
DEEPL_API_KEY=

# ---------------------------------------------------------------------------
# 모델 순위표 (선택) — 없으면 순위 탭만 비고 브리핑은 정상 동작합니다
# ---------------------------------------------------------------------------

# artificialanalysis.ai/data-api 에서 발급. 무료 등급은 하루 100회까지.
# 무료 등급은 순위·점수까지만 주고 영상·이미지 가격은 주지 않습니다.
AA_API_KEY=
